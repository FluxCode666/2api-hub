# 2API Hub 生产环境变量模板
# 复制为 deploy/.env.prod 并填写。所有标 ? 的变量必填。

# ---- 镜像 ----
# 应用镜像 tag（GitHub Release 的 semver tag，如 v0.1.0）
HUB_IMAGE_TAG=v0.1.0

# ---- 数据库 ----
POSTGRES_USER=hub
# 数据库密码（必填，强随机）
POSTGRES_PASSWORD=
POSTGRES_DB=hub
# 完整连接串（compose 会自动拼接，一般不需要改）
# DATABASE_URL=postgres://hub:${POSTGRES_PASSWORD}@postgres:5432/hub

# ---- 安全密钥 ----
# AES-256-GCM 加密渠道 API Key，64 位 hex。生成：openssl rand -hex 32
APP_ENCRYPTION_KEY=
# JWT 会话签名密钥，任意长随机字符串。生成：openssl rand -hex 32
SESSION_SECRET=

# ---- 首次初始化管理员（可选，仅首次启动时创建） ----
# 管理员邮箱（留空则不创建）
INIT_ADMIN_EMAIL=
# 管理员密码（≥12 位，留空则不创建）
INIT_ADMIN_PASSWORD=

# ---- 站内热更新 ----
# GitHub Release 仓库（默认 FluxCode666/2api-hub）
HUB_RELEASE_REPOSITORY=FluxCode666/2api-hub
# GitHub Token（可选，私有仓库或提高限额用，只在服务端使用）
HUB_GITHUB_TOKEN=

# ---- 网络与安全 ----
# SSRF 防护：生产必须 false（禁止探测私网/回环地址）
ALLOW_PRIVATE_PROBE=false
# 代理信任：默认 false（不信任 X-Forwarded-For）；反向代理后设 loopback 或具体网段
TRUST_PROXY=false
# Cookie Secure：直连 HTTP 时设 false；上 HTTPS 后改 true
COOKIE_SECURE=false
# 站点对外访问域名（canonical / sitemap / OG 使用）
HUB_SITE_URL=http://64.81.113.70:3210

# ---- 运行时 ----
NODE_ENV=production
