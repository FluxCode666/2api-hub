# 2API Hub 生产环境变量模板
# 复制为 deploy/.env.prod 并填写。所有标 ? 的变量必填。

# ---- 数据库 ----
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hub

# ---- 安全密钥 ----
# AES-256-GCM 加密渠道 API Key，64 位 hex。生成：openssl rand -hex 32
APP_ENCRYPTION_KEY=
# JWT 会话签名密钥，任意长随机字符串。生成：openssl rand -hex 32
SESSION_SECRET=

# ---- 端口（默认即可） ----
API_PORT=8711
WEB_PORT=3210
# 站点对外访问域名（canonical / sitemap / OG 使用），构建期与运行期都会用到
HUB_SITE_URL=https://2api.hub
WORKER_HEALTH_PORT=8713
MOCK_UPSTREAM_PORT=8712

# ---- SSRF 防护 ----
# 生产必须 false（禁止探测私网/回环地址）；仅本地开发连 mock-upstream 时为 true
ALLOW_PRIVATE_PROBE=false

# ---- 代理信任（默认 false，不信任 X-Forwarded-For） ----
# 反向代理（nginx/Cloudflare）后设 loopback 或代理网段；直达 API 不要开
# TRUST_PROXY=loopback

# ---- Cookie ----
# 生产 HTTPS 下自动开启 Secure（NODE_ENV=production）；如需强制可设 true
# COOKIE_SECURE=true

# ---- 容器监听 ----
# API 容器内必须监听 0.0.0.0（compose 已设置 API_HOST=0.0.0.0）
# API_HOST=0.0.0.0
